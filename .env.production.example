# Variables de entorno para producción (GoDaddy cPanel)

# Entorno: production desactiva el toolbar y los errores detallados
CI_ENVIRONMENT = production

# URL pública del sitio (cambiar por el dominio real)
app.baseURL = 'https://tudominio.com.co/'

# Base de datos (crear en cPanel → MariaDB Databases)
database.default.hostname = 'localhost'
database.default.database = 'cpaneluser_eventos'
database.default.username = 'cpaneluser_eventos'
database.default.password = 'CAMBIAR_ESTA_CLAVE'
database.default.DBDriver = 'MySQLi'
database.default.port = 3306

# Sesiones en base de datos (ya configurado por defecto)
# No hace falta cambiar nada: ci_sessions se crea automáticamente.
